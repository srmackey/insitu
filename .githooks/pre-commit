#!/bin/sh
# Public-repo hygiene gate. Refuses a commit that would publish local chair
# overlay, generated files carrying a vault path, secrets, or any term in an
# untracked denylist. Enable with: git config core.hooksPath .githooks
#
# The denylist is NOT tracked. Put one term per line in .git/hygiene-denylist
# so real names never enter the repo that this hook protects.

fail=0
say() { printf '%s\n' "$*" >&2; }
bad() { fail=1; say "BLOCKED: $*"; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. Local chair overlay must never be staged. This is what a blanket
#    "git add -A" sweeps in.
for f in $staged; do
  case "$f" in
    .claude/*|.cursor/*|.grok/*|.codex/*|.agents/*) bad "host overlay staged: $f" ;;
    PROTOCOL.md|*/PROTOCOL.md)                     bad "generated protocol staged: $f" ;;
    STATUS.md|*/STATUS.md)                         bad "local chair status staged: $f" ;;
    project.yaml|*/project.yaml)                   bad "local host config staged: $f" ;;
    inbox/*|_system/*|docs/superpowers/*)          bad "local-only tree staged: $f" ;;
  esac
done

# Added lines only, and never this hook's own source: its patterns would
# otherwise match themselves and train you to ignore it.
added=$(git diff --cached -U0 -- . ':(exclude).githooks/' | grep '^+' | grep -v '^+++')
[ -z "$added" ] && added=""

# 2. Generated files carry a vault path in their header. Catch them by marker,
#    whatever they are named.
printf '%s\n' "$added" | grep -qi 'insitu-generated:[[:space:]]*true' &&
  bad "staged content carries an insitu-generated header (it embeds a vault path)"

# 3. Absolute home paths identify the operator.
printf '%s\n' "$added" | grep -qE '([A-Za-z]:\Users\|/home/[a-z]|/Users/[A-Za-z])' &&
  bad "staged content contains an absolute home path"

# 4. Common secret shapes.
printf '%s\n' "$added" | grep -qE '(sk-[A-Za-z0-9]{16,}|ghp_[A-Za-z0-9]{20,}|github_pat_|AKIA[0-9A-Z]{12,}|BEGIN [A-Z ]*PRIVATE KEY)' &&
  bad "staged content looks like a credential"

# 5. Untracked denylist: one term per line, blank lines and # comments ignored.
deny="$(git rev-parse --git-dir)/hygiene-denylist"
if [ -f "$deny" ]; then
  while IFS= read -r term; do
    [ -z "$term" ] && continue
    case "$term" in \#*) continue ;; esac
    if printf '%s\n' "$added" | grep -qiF -- "$term"; then
      bad "staged content contains a denylisted term (line $(printf '%s\n' "$added" | grep -niF -- "$term" | head -1 | cut -d: -f1) of the staged additions)"
    fi
  done < "$deny"
else
  say "note: no $deny; name-based checks are off."
fi

if [ "$fail" -ne 0 ]; then
  say ""
  say "Nothing was committed. Unstage the offending paths, or fix the content."
  say "Never use 'git add -A' in this repo; stage paths by name."
  say "Deliberate override: git commit --no-verify"
  exit 1
fi
exit 0
